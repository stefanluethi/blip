{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-only.py\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "blip-tools": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  },
  "enabledPlugins": {
    "blip-lsp@blip-tools": true
  }
}
