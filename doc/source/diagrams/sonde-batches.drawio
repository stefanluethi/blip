<mxfile host="drawio" version="19.0.3">
  <diagram id="sonde-batches" name="sonde-batches">
    <mxGraphModel background="#ffffff" dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;Producer&lt;/b&gt;&lt;br&gt;task, thread or ISR&lt;br&gt;&lt;br&gt;value() · metadata()&lt;br&gt;log() · logf() · commit()" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffd0b2;strokeColor=#fe6100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Consumer&lt;/b&gt;&lt;br&gt;send task, DMA ISR&lt;br&gt;&lt;br&gt;take() · release()&lt;br&gt;request_commit()" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d6cffa;strokeColor=#785ef0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Storage&amp;lt;BatchBytes, Batches&amp;gt;&lt;/b&gt; — a ring of batches owned by the user" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="0" width="560" height="24" as="geometry"/></mxCell>
        <mxCell id="c4" value="free" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;html=1;whiteSpace=wrap;rounded=0;fillColor=#eceef0;strokeColor=#6b7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="100" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="open&lt;br&gt;&lt;i&gt;being encoded&lt;/i&gt;" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;html=1;whiteSpace=wrap;rounded=0;fillColor=#ffd0b2;strokeColor=#fe6100;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="100" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value="ready" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;html=1;whiteSpace=wrap;rounded=0;fillColor=#d6cffa;strokeColor=#785ef0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="90" width="100" height="80" as="geometry"/></mxCell>
        <mxCell id="c7" value="ready" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;html=1;whiteSpace=wrap;rounded=0;fillColor=#d6cffa;strokeColor=#785ef0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="100" height="80" as="geometry"/></mxCell>
        <mxCell id="c8" value="taken&lt;br&gt;&lt;i&gt;being sent&lt;/i&gt;" style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;html=1;whiteSpace=wrap;rounded=0;fillColor=#d0ddff;strokeColor=#648fff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="90" width="100" height="80" as="geometry"/></mxCell>
        <mxCell id="c9" value="encode messages" style="strokeColor=#5b6168;fontColor=#24292e;labelBackgroundColor=#ffffff;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;" edge="1" parent="1" source="c1" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="50"/></Array></mxGeometry></mxCell>
        <mxCell id="c10" value="take()" style="strokeColor=#5b6168;fontColor=#24292e;labelBackgroundColor=#ffffff;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;verticalAlign=bottom;" edge="1" parent="1" source="c8" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="commit() or full" style="strokeColor=#5b6168;fontColor=#24292e;labelBackgroundColor=#ffffff;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;html=1;endArrow=block;endFill=1;fontSize=10;rounded=0;verticalAlign=top;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="182" as="sourcePoint"/><mxPoint x="505" y="182" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c12" value="release()" style="strokeColor=#5b6168;fontColor=#24292e;labelBackgroundColor=#ffffff;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;verticalAlign=bottom;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="250"/><mxPoint x="280" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="c13" value="Producer and consumer share only two &lt;b&gt;atomic indices&lt;/b&gt;, each written by one side: no locks, works from ISRs and on Cortex-M0. The producer never blocks: with no free batch it drops the message, returns &lt;b&gt;Status::Full&lt;/b&gt; and counts it in &lt;b&gt;dropped()&lt;/b&gt;. A batch holds only whole messages, a CBOR sequence ready for one UDP datagram or file write." style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="1000" height="60" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;With a Sink&lt;/b&gt; (desktop, unit test): producer and consumer are one context — a ready batch goes to &lt;b&gt;Sink::write&lt;/b&gt; right away, e.g. a &lt;b&gt;FileSink&lt;/b&gt; writing a *.blip recording." style="fontColor=#24292e;fontFamily=Fira Sans,Helvetica,Arial,sans-serif;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f4bed9;strokeColor=#dc267f;fontSize=12;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="1000" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
